<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>System - Add New Game</title>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/create.css">
</head>
<body>
    <div class="createContainer">
        <div class="systemHeader">
            <h2>INITIALIZE NEW DATA</h2>
        </div>

        <div class="formPanel">
            <form action="/GameShop/Create" method="post" class="gameForm">
                <div class="formGroup">
                    <label class="formLabel" for="Id">ID</label>
                    <input class="inputField" type="text" id="Id" name="Id" placeholder="ENTER GAME ID" required />
                </div>
                <div class="formGroup">
                    <label class="formLabel" for="Title">TITLE_</label>
                    <input class="inputField" type="text" id="Title" name="Title" placeholder="ENTER GAME TITLE" required />
                </div>

                <div class="formGroup">
                    <label class="formLabel" for="Genre">GENRE_</label>
                    <input class="inputField" type="text" id="Genre" name="Genre" placeholder="ENTER CATEGORY" required />
                </div>

                <div class="formGroup">
                    <label class="formLabel" for="Rating">RATING_</label>
                    <input class="inputField" type="number" step="0.1" min="0" max="10" id="Rating" name="Rating" placeholder="0.0 - 10.0" required />
                </div>

                <div class="buttonGroup">
                    <button type="submit" class="submitBtn">SAVE DATA</button>
                    <a href="/GameShop" class="cancelBtn">CANCEL</a>
                </div>

            </form>
        </div>
    </div>
</body>
</html>